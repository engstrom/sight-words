{
  // The site is static files in public/; the Worker only runs for paths that aren't one (the sync API).
  "name": "sight-words",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sight-words",
      // Filled in by `wrangler d1 create sight-words`; local dev ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
}
