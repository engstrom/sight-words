{
  // The site is static files in public/; the Worker only runs for paths that aren't one (the sync API).
  "name": "sight-words",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sight-words",
      "database_id": "8674e769-487d-4c87-84b4-5ee902caa602"
    }
  ],
  "observability": { "enabled": true }
}
